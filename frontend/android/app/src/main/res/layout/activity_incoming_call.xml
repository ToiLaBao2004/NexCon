<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/incoming_call_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="56dp"
    android:paddingEnd="28dp"
    android:paddingBottom="48dp">

    <TextView
        android:id="@+id/callTypeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="Cuộc gọi đến"
        android:textAllCaps="true"
        android:textColor="#BDEBFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callerInitialText"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/incoming_call_avatar_background"
        android:gravity="center"
        android:text="N"
        android:textColor="#05245C"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callerNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="NexCon"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Đang đổ chuông trên NexCon"
        android:textColor="#CCDEEF"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/declineButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/incoming_call_decline_button"
            android:minHeight="58dp"
            android:text="Từ chối"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/answerButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/incoming_call_accept_button"
            android:minHeight="58dp"
            android:text="Trả lời"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
